{
  "manifest_version": 2,
  "name": "ClamAV Mail Check",
  "version": "0.11.1",
  "description": "__MSG_extensionDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "clam-mail-check@local.invalid",
      "strict_min_version": "140.0"
    }
  },
  "permissions": [
    "accountsRead", "messagesRead", "nativeMessaging", "storage",
    "notifications", "menus"
  ],
  "optional_permissions": ["messagesDelete", "downloads"],
  "background": {
    "page": "background.html",
    "persistent": true
  },
  "browser_action": {
    "default_title": "__MSG_toolbarDefaultTitle__",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "content_security_policy": "script-src 'self'; object-src 'none'",
  "default_locale": "en"
}
